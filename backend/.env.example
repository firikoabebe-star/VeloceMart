# Prisma (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-secret"

# CORS (comma-separated list of allowed origins)
FRONTEND_URL="http://localhost:3000"

# Frontend redirect base for OAuth callbacks (single URL, not comma-separated)
FRONTEND_REDIRECT_URL="http://localhost:3000"

# Google Sign-In (OAuth 2.0)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# register the exact callback URL(s) below as Authorized redirect URIs.
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
# Must exactly match the Authorized redirect URI and the global "api" prefix:
#   local:      http://localhost:3001/api/auth/google/callback
#   production: https://velocemart.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Gemini AI (leave empty to disable)
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_TIMEOUT_MS=30000
GEMINI_CACHE_TTL_MS=600000

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="VeloceMart <noreply@example.com>"

# Contact form destination. Messages submitted through POST /api/contact are
# forwarded to this inbox via Resend, with the visitor's address set as
# reply-to. When either RESEND_API_KEY or CONTACT_TO_EMAIL is missing, the
# contact form reports itself as unavailable (503) instead of silently
# accepting messages that cannot be delivered.
CONTACT_TO_EMAIL=
